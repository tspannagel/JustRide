# ---------------------------------------------------------------------------
# ESP-IDF
# ---------------------------------------------------------------------------
build/
build-*/
# Generated by menuconfig; commit sdkconfig.defaults(.*) instead
sdkconfig
sdkconfig.old
# Component manager downloads (keep dependencies.lock committed)
managed_components/
# idf.py / esptool leftovers
*.bin
*.elf
*.map
flasher_args.json
compile_commands.json
.cache/
core_dump*

# ---------------------------------------------------------------------------
# Arduino / PlatformIO
# ---------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.arduino/
*.ino.bin
*.ino.elf
*.ino.map
*.ino.*.bin

# ---------------------------------------------------------------------------
# Host unit tests (CMake + ctest)
# ---------------------------------------------------------------------------
test/host/build/
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
Testing/
cmake-build-*/
*.o
*.a
*.d
*.gcda
*.gcno
*.gcov
coverage/

# ---------------------------------------------------------------------------
# Statistics app (www/stats)
# vendor/ (DuckDB-WASM 34 MB, uPlot) is produced by tools/vendor_stats.sh from
# pinned versions and copied to the SD card; it is not committed.
# ---------------------------------------------------------------------------
node_modules/
www/stats/vendor/
*.duckdb
*.duckdb.wal

# ---------------------------------------------------------------------------
# Ride data and secrets (never commit real rides, Wi-Fi creds or API keys)
# Sample files belong in tools/, captured BLE traffic in test/host/fixtures/
# ---------------------------------------------------------------------------
/rides/
/sd/
*.fit
!tools/**/*.fit
!test/host/fixtures/**/*.fit
secrets.h
secrets.json
.env
.env.*

# ---------------------------------------------------------------------------
# Python (tools/, fitdecode validators)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
.idea/
*.swp
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------------------------------------------------------------------------
