<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>JustRide</author>
    <name>Sweet Spot 3x10</name>
    <description>3 x 10 min at 90 % FTP with 5 min recovery.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.90" OffPower="0.55" Cadence="90" CadenceResting="85"/>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
