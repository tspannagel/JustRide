CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Flash: 16 MB, custom partitions with two OTA slots
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: 8 MB octal at 80 MHz, code + rodata in PSRAM so flash access
# doesn't stall the RGB panel (IDF >= 5.3 name; older: SPIRAM_FETCH_INSTRUCTIONS + SPIRAM_RODATA)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# RGB panel
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
# Bounce-buffer ISR keeps running while flash is busy (Wi-Fi start, OTA): otherwise the image shifts
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# 64-byte data cache lines: the panel's PSRAM reads otherwise starve and the
# picture shifts/ghosts (Espressif RGB LCD FAQ; Waveshare V4 examples). Cache stays
# 32 KB: 64 KB costs internal RAM that BLE needs (BLE_INIT malloc failed).
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Console on native USB
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FATFS long file names (ride files, workouts)
CONFIG_FATFS_LFN_HEAP=y

# OTA: roll back automatically if new firmware doesn't reach app_main's end
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bluetooth: NimBLE central only, host on core 0, buffers in PSRAM
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=6
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Wi-Fi + BLE coexistence (Wi-Fi only runs off the bike)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# HTTP server: long URIs for /stats/vendor/... paths
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# LVGL fonts used by the UI
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# LVGL: system malloc (internal RAM, then PSRAM) instead of the fixed 64 KB pool,
# which all screens built at start-up overflow (as in Waveshare's V4 examples)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
